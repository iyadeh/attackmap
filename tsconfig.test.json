{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".next/risk-tests",
    "plugins": [],
    "rootDir": "src",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/types/architecture.ts",
    "src/types/security.ts",
    "src/lib/architecture/autosave-coordinator.ts",
    "src/lib/architecture/autosave-coordinator.test.ts",
    "src/lib/db/**/*.ts",
    "src/lib/risk-engine/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
